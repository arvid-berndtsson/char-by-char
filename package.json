{
  "name": "char-by-char",
  "version": "0.1.0",
  "description": "Background utility that types clipboard text character-by-character via global hotkeys.",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "char-by-char": "./src/main.js"
  },
  "scripts": {
    "start": "node ./src/main.js",
    "check": "node --check ./src/main.js && node --check ./src/clipboardTyper.js"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.2",
    "clipboardy": "^4.0.0",
    "node-global-key-listener": "^0.3.0"
  }
}
